{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageGate participant enrollment",
  "type": "object",
  "required": ["participant_id", "eligibility_status", "identity_token_hash", "source_row_hash", "data_use_scope"],
  "properties": {
    "participant_id": {"type": "string", "minLength": 1},
    "consent_document_id": {"type": ["string", "null"]},
    "eligibility_status": {"enum": ["eligible", "ineligible", "pending"]},
    "consented_at": {"type": "string"},
    "withdrawn_at": {"type": "string"},
    "identity_token_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_row_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "data_use_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  }
}
