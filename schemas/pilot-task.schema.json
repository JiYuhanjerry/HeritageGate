{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageGate pilot task",
  "type": "object",
  "required": ["task_code", "title", "description", "expected_outcome", "sequence_order", "required"],
  "properties": {
    "task_code": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "expected_outcome": {"type": "string", "minLength": 1},
    "gate_scope": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
    "sequence_order": {"type": "integer", "minimum": 1},
    "required": {"type": "boolean"}
  }
}
