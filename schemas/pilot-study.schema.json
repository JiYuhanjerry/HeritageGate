{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageGate pilot study",
  "type": "object",
  "required": ["study_title", "protocol_version", "study_design", "ethics_status", "planned_sample_size", "primary_outcomes", "secondary_outcomes", "inclusion_criteria", "exclusion_criteria"],
  "properties": {
    "study_title": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "study_design": {"enum": ["single_group", "crossover", "parallel", "observational"]},
    "ethics_status": {"enum": ["approved", "exempt", "pending", "not_required"]},
    "ethics_ref": {"type": "string"},
    "planned_sample_size": {"type": "integer", "minimum": 1},
    "primary_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "secondary_outcomes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "inclusion_criteria": {"type": "string", "minLength": 1},
    "exclusion_criteria": {"type": "string", "minLength": 1},
    "preregistration_ref": {"type": "string"}
  }
}
