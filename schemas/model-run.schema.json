{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageGate model run",
  "type": "object",
  "required": [
    "model_name",
    "model_version",
    "constraint_method",
    "parameters",
    "source_element_ids",
    "output_count",
    "provenance_ref",
    "run_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "constraint_method": {
      "type": "string",
      "minLength": 1
    },
    "model_ref": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "source_element_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_count": {
      "type": "integer",
      "minimum": 0
    },
    "provenance_ref": {
      "type": "string",
      "minLength": 1
    },
    "run_status": {
      "enum": [
        "completed",
        "failed",
        "rejected"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
