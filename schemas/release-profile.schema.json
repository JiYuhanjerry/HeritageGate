{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageGate release profile",
  "type": "object",
  "required": ["software_title", "manuscript_title", "software_version", "release_status", "evidence_status", "license_spdx", "authors", "keywords"],
  "properties": {
    "software_title": {"type": "string", "minLength": 1},
    "manuscript_title": {"type": "string", "minLength": 1},
    "software_version": {"type": "string", "minLength": 1},
    "release_status": {"enum": ["draft", "candidate", "released"]},
    "evidence_status": {"enum": ["synthetic", "real_pilot", "validated_real_pilot"]},
    "repository_url": {"type": "string"},
    "archive_url": {"type": "string"},
    "software_doi": {"type": "string"},
    "executable_url": {"type": "string"},
    "documentation_url": {"type": "string"},
    "support_email": {"type": "string"},
    "license_spdx": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name"]}},
    "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
