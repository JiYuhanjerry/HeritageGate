{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageGate consent document metadata",
  "type": "object",
  "required": ["document_title", "document_version", "language", "body_ref", "body_sha256", "effective_from", "withdrawal_contact", "retention_policy"],
  "properties": {
    "id": {"type": "string"},
    "document_title": {"type": "string", "minLength": 1},
    "document_version": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "ethics_ref": {"type": "string"},
    "body_ref": {"type": "string", "minLength": 1},
    "body_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "effective_from": {"type": "string", "minLength": 1},
    "withdrawal_contact": {"type": "string", "minLength": 1},
    "retention_policy": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
