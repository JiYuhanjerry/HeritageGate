{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageGate pilot task attempt",
  "type": "object",
  "required": ["session_id", "task_id", "started_at", "ended_at", "success", "completion_status", "assistance_count", "error_count", "evidence_ref"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "success": {"type": "boolean"},
    "completion_status": {"enum": ["completed", "failed", "abandoned"]},
    "assistance_count": {"type": "integer", "minimum": 0},
    "error_count": {"type": "integer", "minimum": 0},
    "evidence_ref": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
